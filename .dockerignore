.DS_Store
.dockerignore
.env
.env.*
.git
.gitignore
.github/
.idea
.sops.yaml

# Runtime Canvas configuration contains credentials and must be mounted.
/config/*.yml
/config/*.yml.cached
!/config/brakeman.yml
!/config/brandable_css.yml
!/config/browsers.yml
!/config/code_ownership.yml
!/config/credentials.test.yml
!/config/crystalball.yml
!/config/styleguide.yml

# Deployment assets are not part of the Canvas application image.
/ops/

build/
!build/vendor/woff-code-latest.zip
!build/gergich/
!build/new-jenkins/
!build/docker_utils.rb
!build/dockerfile_writer.rb
!build/Dockerfile.template
docker-compose/
!docker-compose/config/*
docker-compose.local.*.yml
docker-compose.override.yml

coverage/
coverage-js/
gems/*/node_modules/
gems/plugins/*/node_modules/
gems/plugins/*/.git
/log/*
!/log/.keep
!/log/parallel-runtime-rspec.log
node_modules/
packages/*/node_modules/
public/dist/
public/doc/
public/javascripts/translations/
!public/javascripts/translations/en.json
log/
!log/.keep
tmp/*
vendor/bundle/
vendor/*/.git
Dockerfile
*.Dockerfile
mkmf.log
